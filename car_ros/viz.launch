<launch>
  <!-- Live obstacle view + keyboard driving. No SLAM: nothing here builds or
       keeps a map, the laptop only ever sees the current scan.
       For mapping use mapping.launch instead. -->

  <arg name="lidar_port" default="/dev/rplidar"/>
  <arg name="base_port"  default="/dev/myserial"/>

  <!-- Lidar mounting, metres and radians. x/y are the offset from the drive
       centre, z the height of the scan plane: measured at the four-wheel
       centre, 15 cm up. lidar_yaw is which way the sensor's own zero points
       relative to the chassis front. Set it to 0 if the plot ends up mirrored
       front to back. -->
  <arg name="lidar_x" default="0.0"/>
  <arg name="lidar_y" default="0.0"/>
  <arg name="lidar_z" default="0.15"/>
  <arg name="lidar_yaw" default="3.14159265"/>

  <!-- The MCU already takes +x as forward, matching ROS, so no flip. -->
  <arg name="invert_drive" default="false"/>

  <!-- respawn: the ch341 USB-serial adapter drops off the bus spontaneously
       (dmesg 2026-08-04: four re-enumerations, one 36 s after boot while IDLE;
       marginal contact, correlates with motor vibration when driving). When it
       drops, this node's serial fd goes stale and the node DIES on the next write
       (Errno 5); without respawn the whole drive stack then stays down until a
       human intervenes, and mid-drive the MCU latches the last PWM (no firmware
       timeout) until car_base returns and the keep-alive resumes. Respawn shrinks
       that window from "forever" to ~2-3 s; the workstation-side per-tick wedge
       monitor (carclient.imu_frozen) covers the freeze-without-death case. -->
  <node name="car_base" pkg="car_base" type="car_base_node.py" output="screen"
        respawn="true" respawn_delay="2">
    <param name="port" value="$(arg base_port)"/>
    <param name="base_frame" value="base_footprint"/>
    <param name="invert_drive" value="$(arg invert_drive)"/>
    <!-- 10 Hz (was 20): nobody consumes odom/imu faster than 3 Hz; halves the
         Nano's continuous serial+publish load. Still well above the 1 s cmd
         watchdog and fine for odom integration. -->
    <param name="rate" value="10.0"/>
  </node>

  <!-- respawn: the rplidar-watchdog service kills this node to recover a wedged
       lidar; roslaunch then brings it straight back on the same device. -->
  <node name="rplidar" pkg="rplidar_ros" type="rplidarNode" output="screen"
        respawn="true" respawn_delay="3">
    <param name="serial_port" value="$(arg lidar_port)"/>
    <param name="serial_baudrate" type="int" value="115200"/>
    <param name="frame_id" value="laser"/>
    <param name="angle_compensate" type="bool" value="true"/>
  </node>

  <node name="base_to_laser" pkg="tf" type="static_transform_publisher"
        args="$(arg lidar_x) $(arg lidar_y) $(arg lidar_z) $(arg lidar_yaw) 0 0 base_footprint laser 50"/>

  <!-- scan_bridge (TCP :9870 for non-ROS laptops) removed: the client is pure
       ROS now and reads /obstacles + drives via /drive_action. Re-add it here
       only if you bring back the old perception_server.py (:9871). -->

  <!-- Fast C++ clustering: /scan -> obstacle circles ("collision spheres").
       Publishes /obstacles (Float32MultiArray [x,y,r,...], metres, base frame)
       at a fixed 3 Hz, plus /obstacles_viz for rviz. ~3.4 ms/frame, so 3 Hz is
       far under the lidar's ~7.7 Hz ceiling; set rate_hz to 0 for max rate.
       Reuses this launch's lidar_x/y/yaw so the laser->base transform always
       matches the static_transform_publisher above. -->
  <node name="obstacle_circles" pkg="obstacle_perception"
        type="obstacle_circles_node" output="screen">
    <param name="rate_hz"     value="3.0"/>
    <param name="scan_topic"  value="/scan"/>
    <param name="frame_id"    value="base_footprint"/>
    <param name="eps"         value="0.20"/>
    <param name="min_samples" value="5"/>
    <param name="margin"      value="0.02"/>
    <param name="max_radius"  value="0.30"/>
    <!-- temporal filter: ego-motion-compensated per-circle EMA so circles don't
         jitter as the clustered points change (filter_alpha 0=off; assoc = max
         match distance between frames, m). Uses /odom for ego-motion. -->
    <param name="filter_alpha" value="0.5"/>
    <param name="filter_assoc" value="0.4"/>

    <!-- /obstacle_points: the exact base-frame points this frame's circles were
         clustered from, tagged with the SAME frame_id, so a viewer can draw the
         point cloud and the circles as one sample. Subscribing to /scan instead
         cannot be synchronised: this node runs on its own rate_hz timer off the
         latest scan, so it uses only ~1 in 2-3 of the lidar's ~7.7 Hz scans.
         Only published while something subscribes. points_stride > 1 decimates. -->
    <param name="publish_points" value="true"/>
    <param name="points_stride"  value="1"/>
    <param name="lidar_yaw"   value="$(arg lidar_yaw)"/>
    <param name="lidar_x"     value="$(arg lidar_x)"/>
    <param name="lidar_y"     value="$(arg lidar_y)"/>
  </node>

  <!-- Discrete mecanum drive-action server: /drive_action ([id,mag,dur]) ->
       timed /wheel_cmd pulses (open loop). Republishes at 20 Hz so car_base's
       watchdog never brakes mid-step; reports /drive_result on completion. -->
  <node name="drive_action" pkg="car_base" type="drive_action_node.py" output="screen">
    <param name="rate_hz"            value="20.0"/>
    <param name="default_magnitude"  value="40.0"/>
    <param name="default_duration_s" value="0.8"/>
    <!-- max_magnitude 80: cap on the FINAL applied magnitude (after the diagonal
         x2 boost). base 40 -> diagonal 80 reaches (n,n) exactly. (The old 50 cap
         was from a mis-diagnosed brownout; the real instability was the removed
         rplidar-watchdog.) -->
    <param name="max_magnitude"      value="80.0"/>
    <param name="max_duration_s"     value="3.0"/>   <!-- hard cap: a stray cmd can't run >3s -->
  </node>
</launch>
